# Copy to .env (chmod 600). Keys can also be set later in the web UI (设置).
ADMIN_USER=admin
# Optional: fixed first password; if empty a random one is printed once in `docker compose logs app`
ADMIN_INITIAL_PASSWORD=
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OLLAMA_MODEL=qwen3:8b
